# ETF Overlap Analyzer - Environment Configuration
# Copy this file to .env and configure for your environment

# === Flask Configuration ===
FLASK_ENV=development|production|testing
FLASK_DEBUG=false
SECRET_KEY=generate-a-random-secret-key-here

# === Server Configuration ===
HOST=127.0.0.1
PORT=3003

# === Security Configuration ===
HTTPS_ONLY=true
HSTS_MAX_AGE=31536000
MAX_ISINS_PER_REQUEST=10
MAX_REQUEST_SIZE_BYTES=10240
SUBPROCESS_TIMEOUT_SECONDS=60

# === Rate Limiting ===
RATELIMIT_STORAGE_URL=memory://
RATELIMIT_DEFAULT=200 per day;50 per hour
RATELIMIT_ANALYZE=10 per minute

# === Database Configuration ===
ETF_DATABASE_PATH=./data/etf_cache.db
ETF_CACHE_EXPIRY_HOURS=24

# === Logging ===
LOG_LEVEL=INFO
LOG_FILE=

# === Content Security Policy ===
CONTENT_SECURITY_POLICY=default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; frame-ancestors 'none';